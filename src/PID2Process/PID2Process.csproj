<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <Version>0.10.0</Version>
    <ApplicationIcon>../../_media/FlowSketch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>cs-systems GmbH</Company>
    <Product>FlowSketch</Product>
    <AssemblyName>FlowSketch</AssemblyName><RootNamespace>PID2Process</RootNamespace>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="PDFsharp-WPF" Version="6.2.4" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../examples/FlowSketch-Demo.pid2process.json" LogicalName="PID2Process.Demo.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="ReviewScene.js" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="ReviewZoom.js" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="SymbolDefinitions.json" /></ItemGroup>
  <ItemGroup>
    <Resource Include="../../_media/FlowSketch.ico" Link="Assets/favicon.ico" />
    <Resource Include="../../_media/CS26001-1-Logo-4c.png" Link="Assets/logo.png" />
    <EmbeddedResource Include="../../_media/companyInfo.txt" LogicalName="PID2Process.CompanyInfo.txt" />
    <EmbeddedResource Include="../../docs/Hilfe.md" LogicalName="PID2Process.HelpGuide.md" />
    <Resource Include="../../_media/help/*.png" Link="Help/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
